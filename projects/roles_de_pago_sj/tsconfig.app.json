{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "types": [],
    "paths": {
      "@lumen/*": [
        "../../libs/*/src/public-api.ts"
      ],
      "@models": [
        "./src/app/core/models"
      ],
      "@services": [
        "./src/app/core/services"
      ],
      "@components": [
        "./src/app/shared/components"
      ],
      "@components/*": [
        "./src/app/shared/components/*"
      ],
      "@env": [
        "./src/env"
      ],
      "@core/*": [
        "./src/app/core/*"
      ],
      "@/*": [
        "./src/*"
      ]
    }
  },
  "include": [
    "src/**/*.ts"
  ],
  "exclude": [
    "src/**/*.spec.ts"
  ]
}
