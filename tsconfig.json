{
  "compileOnSave": false,
  "compilerOptions": {
    "noImplicitOverride": true,
    "noPropertyAccessFromIndexSignature": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "experimentalDecorators": true,
    "importHelpers": true,
    "paths": {
      "@lumen/ui": [
        "./libs/ui/src/public-api.ts"
      ],
      "@lumen/auth": [
        "./libs/auth/src/public-api.ts"
      ],
      "@lumen/http": [
        "./libs/http/src/public-api.ts"
      ],
      "@lumen/base": [
        "./libs/base/src/public-api.ts"
      ],
      "@lumen/*": [
        "./libs/*/src/public-api.ts"
      ]
    },
    "target": "ES2022",
    "module": "preserve"
  },
  "angularCompilerOptions": {
    "enableI18nLegacyMessageIdFormat": false,
    "strictInjectionParameters": true,
    "strictInputAccessModifiers": true
  },
  "files": [],
  "references": [
    {
      "path": "./libs/ui/tsconfig.lib.json"
    },
    {
      "path": "./libs/ui/tsconfig.spec.json"
    },
    {
      "path": "./libs/auth/tsconfig.lib.json"
    },
    {
      "path": "./libs/auth/tsconfig.spec.json"
    },
    {
      "path": "./libs/http/tsconfig.lib.json"
    },
    {
      "path": "./libs/http/tsconfig.spec.json"
    },
    {
      "path": "./libs/base/tsconfig.lib.json"
    },
    {
      "path": "./libs/base/tsconfig.spec.json"
    },
    {
      "path": "./projects/creditos-cop-sanjose/tsconfig.app.json"
    },
    {
      "path": "./projects/creditos-cop-sanjose/tsconfig.spec.json"
    }
  ]
}
